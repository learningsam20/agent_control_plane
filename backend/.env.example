# Agent Control Plane 2.0 — configuration template
# Copy to backend/.env and adjust. Backend settings also accept these as env vars.

# --- server ---------------------------------------------------------------
PORT=5186
HOST=0.0.0.0
SELF_URL=http://localhost:5186

# SDK / examples base URL (used by controlplane.default_base_url())
CONTROLPLANE_URL=http://localhost:5186

# --- database -------------------------------------------------------------
DATABASE_URL=sqlite:///./data/controlplane.db

# --- security -------------------------------------------------------------
# SECRET_KEY=change-me-in-production

# --- policy engine: auto | native | opa ----------------------------------
# auto tries OPA first and transparently falls back to the native engine when
# OPA is unreachable. Start OPA with:
#   docker run -d --rm --name opa -p 8181:8181 \
#     openpolicyagent/opa run --server --addr 0.0.0.0:8181
# At startup the control plane pushes policies/datahub.rego to OPA
# (package controlplane) and evaluates gateway requests there.
CONTROLPLANE_POLICY_ENGINE=auto
CONTROLPLANE_OPA_URL=http://localhost:8181
# Rego module pushed at startup (auto-resolves to policies/datahub.rego if empty)
# CONTROLPLANE_OPA_POLICY_FILE=

# --- DataHub (optional; catalog runs on the bundled reference data if unset)
# DATAHUB_ENDPOINT=http://localhost:8080
# DATAHUB_TOKEN=

# --- DataHub MCP server (optional; overrides GraphQL reads when enabled) ---
# When USE_DATAHUB_MCP=true, catalog search + lineage reads are routed through
# the @acryldata/mcp-server-datahub MCP server (`uvx mcp-server-datahub@latest`)
# and fall back to GraphQL if it is unreachable. Writes always use DataHub's
# MetadataChangeProposal ingest API.
# USE_DATAHUB_MCP=true
# DATAHUB_MCP_COMMAND=uvx mcp-server-datahub@latest
# DATAHUB_MCP_URL=            # optional SSE endpoint, e.g. http://localhost:8101/sse

# --- DataHub analytics agent (Talk-to-Data; optional) ----------------------
# When USE_ANALYTICS_AGENT=true, POST /api/datahub/analytics answers
# natural-language questions via a running `datahub-analytics-agent` service
# instead of the built-in catalog search.
# USE_ANALYTICS_AGENT=true
# ANALYTICS_AGENT_URL=http://localhost:8100
# ANALYTICS_AGENT_ENGINE=      # engine name used for new conversations

# --- agent LLM (LiteLLM) --------------------------------------------------
# Anything LiteLLM supports: OpenAI-compatible cloud or local endpoints, Ollama…
# Leave LLM_MODEL empty to use the built-in rule-based planner (offline default).
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
# LLM_TEMPERATURE=0.0

# --- agents worker (agent runtime process) --------------------------------
WORKER_POLL_INTERVAL=5.0
WORKER_NAME=worker-default

# --- telemetry (vendor-neutral OpenTelemetry, full MELT) ------------------
# file (default) | otlp | console | none
CONTROLPLANE_TELEMETRY_EXPORTER=file
CONTROLPLANE_TELEMETRY_FILE=data/telemetry/traces.jsonl
CONTROLPLANE_TELEMETRY_METRIC_FILE=data/telemetry/metrics.jsonl
CONTROLPLANE_TELEMETRY_LOG_FILE=data/telemetry/logs.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=controlplane
# OTEL_DEPLOYMENT_ENVIRONMENT=development
